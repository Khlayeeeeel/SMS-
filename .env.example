# ============================================================
# SMS Solaire — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your real values.
# cp .env.example .env
#
# ⚠️  SECURITY RULES:
#   1. NEVER commit the .env file to git.
#   2. NEVER prefix the service role key with NEXT_PUBLIC_.
#   3. Rotate your SUPABASE_SERVICE_ROLE_KEY immediately if it
#      was ever committed or shared publicly.
# ============================================================

# --- PUBLIC (safe to expose to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# --- SECRET (server-only, NEVER prefix with NEXT_PUBLIC_) ---
# Found in: Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
